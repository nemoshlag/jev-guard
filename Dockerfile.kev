# Experimental: runs the open Jev-compatible Kev server (Apache-2.0) from a pinned commit.
# https://github.com/jaredpalmer/kev  -- CPU works but is slow; for CUDA use an NVIDIA
# runtime and a CUDA-enabled torch build.
FROM python:3.14-slim@sha256:f85c5697265c178cc6887276c55fe16cf3d14ca35c3df6a5eab3b360534a55d2
ARG KEV_REF=5e42a7a03f28134853dd3ff77461457e921e5ec1
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.11@sha256:77280f2f771df71f90786c314fe1bbc1e023feac652969bbf139c280babf2eb7 /uv /usr/local/bin/uv
RUN useradd --system --uid 10001 --create-home app
USER app
WORKDIR /home/app
RUN git clone https://github.com/jaredpalmer/kev.git kev \
    && git -C kev checkout "$KEV_REF"
WORKDIR /home/app/kev
RUN uv sync --frozen --extra serve
ENV HF_HOME=/home/app/.cache/huggingface
EXPOSE 8009
ENTRYPOINT ["uv", "run", "--frozen", "--extra", "serve", "python", "-m", "kev.serve", "--host", "0.0.0.0", "--port", "8009"]
CMD ["--run", "jaredpalmer/kev-4b"]
